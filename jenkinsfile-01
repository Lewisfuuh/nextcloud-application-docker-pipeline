pipeline{
  tools{
    maven 'Maven3.9.9'
  }

  agent   any 

  environment{
    registry =  "443370676082.dkr.ecr.us-east-1.amazonaws.com/lewis-project-3"
  }

  stages{
    stage('checkout'){
      steps{
        checkout scmGit(branches: [[name: '*/weh']], extensions: [], userRemoteConfigs: [[url: 'https://github.com/Lewisfuuh/nextcloud-application-docker-pipeline.git']])

      }
    }

    stage("Build Image"){
      steps{
        script {
          dockerImage = docker.build registry
          dockerImage.tag("BUILD_NUMBER")
        }
      }
    }

    stage("Push to ECR"){
      steps{
        script{
          sh 'aws ecr get-login-password --region us-east-1 | docker login --username AWS --password-stdin 443370676082.dkr.ecr.us-east-1.amazonaws.com'
          sh 'docker push 443370676082.dkr.ecr.us-east-1.amazonaws.com/lewis-project-3:$BUILD_NUMBER'
        }
      }
    }
  }
}
